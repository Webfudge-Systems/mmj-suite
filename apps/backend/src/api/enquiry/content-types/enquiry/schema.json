{
  "kind": "collectionType",
  "collectionName": "enquiries",
  "info": {
    "singularName": "enquiry",
    "pluralName": "enquiries",
    "displayName": "Enquiry",
    "description": "A sales lead: a website request, phone call or walk-in, followed up until it is won or lost."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "number": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 20
    },
    "name": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string",
      "maxLength": 15
    },
    "email": {
      "type": "email"
    },
    "message": {
      "type": "text"
    },
    "source": {
      "type": "enumeration",
      "enum": [
        "website",
        "walk_in",
        "phone",
        "whatsapp",
        "referral",
        "other"
      ],
      "required": true,
      "default": "website"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "new",
        "contacted",
        "visit_booked",
        "won",
        "lost"
      ],
      "required": true,
      "default": "new"
    },
    "items": {
      "type": "json"
    },
    "log": {
      "type": "json"
    },
    "followUpOn": {
      "type": "date"
    },
    "visitOn": {
      "type": "date"
    },
    "lostReason": {
      "type": "string"
    },
    "customer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::customer.customer"
    },
    "assignedTo": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "branch": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::branch.branch"
    },
    "organization": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::organization.organization"
    }
  }
}
