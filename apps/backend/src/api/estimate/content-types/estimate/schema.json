{
  "kind": "collectionType",
  "collectionName": "estimates",
  "info": {
    "singularName": "estimate",
    "pluralName": "estimates",
    "displayName": "Estimate",
    "description": "Pieces a customer chose, waiting at the counter to be billed."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "number": {
      "type": "string",
      "required": true,
      "maxLength": 40
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "open",
        "billed",
        "cancelled"
      ],
      "required": true,
      "default": "open"
    },
    "lines": {
      "type": "json",
      "required": true
    },
    "note": {
      "type": "text"
    },
    "billedAt": {
      "type": "datetime"
    },
    "cancelledAt": {
      "type": "datetime"
    },
    "customer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::customer.customer"
    },
    "salesperson": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "invoice": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::invoice.invoice"
    },
    "branch": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::branch.branch"
    },
    "organization": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::organization.organization"
    }
  }
}
