{
  "kind": "collectionType",
  "collectionName": "scheme_payments",
  "info": {
    "singularName": "scheme-payment",
    "pluralName": "scheme-payments",
    "displayName": "Scheme payment",
    "description": "One instalment received on a gold savings scheme. Counted in the day close like any other money in."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "number": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 20
    },
    "instalmentNo": {
      "type": "integer",
      "required": true
    },
    "amount": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "payments": {
      "type": "json"
    },
    "account": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::scheme-account.scheme-account"
    },
    "customer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::customer.customer"
    },
    "by": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "branch": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::branch.branch"
    },
    "organization": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::organization.organization"
    }
  }
}
