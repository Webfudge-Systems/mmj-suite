{
  "kind": "collectionType",
  "collectionName": "journal_posts",
  "info": {
    "singularName": "journal-post",
    "pluralName": "journal-posts",
    "displayName": "Journal post",
    "description": "A note from the workshop."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text",
      "required": true
    },
    "category": {
      "type": "string"
    },
    "readingTime": {
      "type": "string"
    },
    "publishedOn": {
      "type": "date"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "body": {
      "type": "richtext",
      "required": true
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
