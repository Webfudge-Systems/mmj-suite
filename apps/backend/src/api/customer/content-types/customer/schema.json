{
  "kind": "collectionType",
  "collectionName": "customers",
  "info": {
    "singularName": "customer",
    "pluralName": "customers",
    "displayName": "Customer",
    "description": "A person or business who buys from or sells to the shop."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true,
      "maxLength": 15
    },
    "altPhone": {
      "type": "string",
      "maxLength": 15
    },
    "email": {
      "type": "email"
    },
    "address": {
      "type": "text"
    },
    "city": {
      "type": "string"
    },
    "pan": {
      "type": "string",
      "maxLength": 10
    },
    "gstin": {
      "type": "string",
      "maxLength": 15
    },
    "notes": {
      "type": "text"
    },
    "branch": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::branch.branch"
    },
    "organization": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::organization.organization"
    }
  }
}
