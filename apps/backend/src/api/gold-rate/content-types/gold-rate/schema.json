{
  "kind": "collectionType",
  "collectionName": "gold_rates",
  "info": {
    "singularName": "gold-rate",
    "pluralName": "gold-rates",
    "displayName": "Gold rate",
    "description": "A per-gram counter rate for a given metal and purity."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true
    },
    "purity": {
      "type": "enumeration",
      "enum": ["24KT", "22KT", "18KT", "14KT", "950PT", "925"],
      "required": true
    },
    "metal": {
      "type": "enumeration",
      "enum": ["gold", "diamond", "silver", "platinum", "bullion"],
      "required": true
    },
    "ratePerGram": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "changePerGram": {
      "type": "decimal"
    },
    "quotedOn": {
      "type": "date",
      "required": true
    }
  }
}
