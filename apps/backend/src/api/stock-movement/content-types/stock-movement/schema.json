        "picked",
        "put_back",
        "reserved",
        "released",
        "sold",
        "returned",
        "sale_cancelled"
      ],
      "required": true
    },
    "fromStatus": {
      "type": "string"
    },
    "toStatus": {
      "type": "string"
    },
    "reference": {
