HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Organization the public website reads rates from
DEFAULT_ORGANIZATION=mmj
# Frontends allowed to call the API with cookies, comma separated
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004
# Optional. Creates an owner account on first boot of an empty database
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=
# Production runs on PostgreSQL
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://user:password@host:5432/mmj
